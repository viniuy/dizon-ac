# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project "dizon-ac" → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jgmgvcpfbulyxwltlxtv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Calendar (service account)
# 1. Google Cloud console → enable "Google Calendar API"
# 2. IAM → Service accounts → create one → Keys → add JSON key
# 3. Google Calendar → "Bookings" → Settings and sharing → share with the
#    service account email, permission "Make changes to events"
# 4. Same page → "Integrate calendar" → copy the Calendar ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the JSON key, keep the quotes and \n escapes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=

# Server-only Supabase secret key (Project Settings → API Keys → Secret keys, "sb_secret_…").
# Used for the staff sign-in codes. It bypasses RLS: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Gmail that sends the staff sign-in codes (lib/two-factor.ts lists who receives them).
# Google Account → Security → 2-Step Verification on → App passwords → create one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
